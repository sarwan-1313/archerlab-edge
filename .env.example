# Optional cloud features — see docs/cloud-setup.md.
# Leave everything empty to keep ArcherLab Edge fully on-device.

# Accounts and backup (Supabase). The anon key is public by design; row-level security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_VIDEO_BUCKET=videos
# VITE_SUPABASE_MAX_UPLOAD_MB=50

# Import from Dropbox on desktop.
VITE_DROPBOX_APP_KEY=

# Import from Google Drive on desktop.
VITE_GOOGLE_API_KEY=
# Also switches on "Save to your Google Drive" (needs only this one)
VITE_GOOGLE_CLIENT_ID=
# Optional: "on" keeps practice log and report backup in the account as well as Drive
VITE_ACCOUNT_DATA_BACKUP=
VITE_GOOGLE_APP_ID=
