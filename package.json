{
  "name": "archerlab-edge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/fetch-pose-models.mjs full heavy --optional --if-missing && npm run build",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:clip": "node scripts/make-e2e-clip.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm test && npm run build",
    "models:pose": "node scripts/fetch-pose-models.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mlc-ai/web-llm": "0.2.86",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
